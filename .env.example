# ==============================================================================
# StockAgent - Plantilla de Variables de Entorno (.env)
# ==============================================================================
# Copie este archivo como '.env' en la raíz del proyecto para definir sus claves y
# configuraciones locales. NUNCA suba su archivo '.env' con valores reales al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIALES ADMINISTRATIVAS Y ACCESO MAESTRO
# ------------------------------------------------------------------------------
# Usuario y contraseña iniciales para el rol Master (superadministrador del sistema).
# Si no se definen, el sistema utilizará por defecto: Desarrollo / master1713
STOCKAGENT_MASTER_USER=Desarrollo
STOCKAGENT_MASTER_PASSWORD=master1713

# Credenciales requeridas para acceso administrativo en menú de consola (menu.py) y GUI clásica
_ADMIN_USUARIO=admin
_ADMIN_CLAVE=admin1234

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL SERVIDOR WEB HTTPS (FLET)
# ------------------------------------------------------------------------------
# Dirección IP en la que escuchará el servidor web (0.0.0.0 escucha en todas las interfaces de red)
STOCKAGENT_HOST=0.0.0.0

# Puerto del servidor web (por defecto 8550)
STOCKAGENT_PORT=8550

# Habilitar servidor seguro HTTPS (1 = Sí, 0 = No)
# Si está en 1 y no se especifican certificados, se genera uno autofirmado en data/certs/
STOCKAGENT_HTTPS=1

# Rutas opcionales a certificados SSL personalizados (dejar en blanco para usar el autofirmado)
STOCKAGENT_SSL_CERT=
STOCKAGENT_SSL_KEY=

# Tiempo de inactividad antes de cerrar sesión automáticamente en minutos (0 = desactivar)
STOCKAGENT_INACTIVIDAD_MINUTOS=720

# Comportamiento de arranque:
# 1 = Oculta la consola de comandos al iniciar en segundo plano
STOCKAGENT_HIDE_CONSOLE=0
# 1 = No abre automáticamente la pestaña del navegador al arrancar
STOCKAGENT_NO_BROWSER=0
# 1 = Desactiva el icono en la bandeja del sistema (System Tray)
STOCKAGENT_NO_TRAY=0

# ------------------------------------------------------------------------------
# 3. NOTIFICACIONES POR CORREO ELECTRÓNICO (SMTP)
# ------------------------------------------------------------------------------
# Servidor SMTP (ej: smtp.gmail.com, smtp.office365.com)
STOCKAGENT_SMTP_SERVER=smtp.gmail.com
STOCKAGENT_SMTP_PORT=587
STOCKAGENT_SMTP_USER=
# Contraseña o App Password de la cuenta emisora
STOCKAGENT_SMTP_PASSWORD=
# Dirección de correo que figura como remitente
STOCKAGENT_SMTP_SENDER=

# ------------------------------------------------------------------------------
# 4. ALERTAS PROACTIVAS POR TELEGRAM BOT
# ------------------------------------------------------------------------------
# Token del bot provisto por @BotFather (ej: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
STOCKAGENT_TELEGRAM_BOT_TOKEN=

# Chat ID o ID del Canal/Grupo al que se enviarán las alertas (ej: -1001234567890 o 123456789)
STOCKAGENT_TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. INTEGRACIÓN CON MERCADO LIBRE API (OAuth 2.0)
# ------------------------------------------------------------------------------
# Credenciales de la aplicación creada en el Centro de Desarrolladores de Mercado Libre
STOCKAGENT_MELI_APP_ID=
STOCKAGENT_MELI_CLIENT_SECRET=
STOCKAGENT_MELI_SELLER_ID=

# Tokens de acceso iniciales (opcional si se gestionan desde el panel gráfico)
STOCKAGENT_MELI_ACCESS_TOKEN=
STOCKAGENT_MELI_REFRESH_TOKEN=
